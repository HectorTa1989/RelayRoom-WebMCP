# Room and portal origins. localhost is considered a trustworthy development origin.
ROOM_ORIGIN=http://localhost:4173
BUYER_ORIGIN=http://localhost:4174
SUPPLIER_ORIGIN=http://localhost:4175
CARRIER_ORIGIN=http://localhost:4176
API_ORIGIN=http://localhost:8787
VITE_ROOM_ORIGIN=http://localhost:4173
VITE_BUYER_ORIGIN=http://localhost:4174
VITE_SUPPLIER_ORIGIN=http://localhost:4175
VITE_CARRIER_ORIGIN=http://localhost:4176
VITE_API_ORIGIN=http://localhost:8787
BUYER_API_PORT=8784
SUPPLIER_API_PORT=8785
CARRIER_API_PORT=8786
RELAYROOM_DATA_DIR=

# First start bootstraps this admin into the account database. Later restarts
# keep the stored account. Use your own credentials before production startup.
ADMIN_EMAIL=admin@relayroom.local
ADMIN_PASSWORD=relay-admin-local
SESSION_SECRET=replace-with-a-long-random-value
RELAYROOM_DEMO=false

# Local operations store the orders, stock, and routes you enter/import.
# Remote requires your integration service implementing docs/connector-contract.md.
BUYER_BACKEND=local
SUPPLIER_BACKEND=local
CARRIER_BACKEND=local
BUYER_CONNECTOR_URL=
BUYER_CONNECTOR_TOKEN=
SUPPLIER_CONNECTOR_URL=
SUPPLIER_CONNECTOR_TOKEN=
CARRIER_CONNECTOR_URL=
CARRIER_CONNECTOR_TOKEN=
# Optional no-cost ERPNext + Shippo Test Mode demo adapter. Keep its credential
# private; these URLs are only accepted over loopback during development.
# Run: npm run demo:providers
# RELAYROOM_CONNECTOR_TOKEN=replace-with-a-separate-random-adapter-token
# PROVIDER_ADAPTER_PORT=8790
# ERPNEXT_URL=http://localhost:8000
# ERPNEXT_API_KEY=
# ERPNEXT_API_SECRET=
# ERPNEXT_ORIGIN=Main Warehouse
# ERPNEXT_DESTINATION=Demo customer location
# ERPNEXT_SUPPLIER_NAME=ERPNext warehouse
# ERPNEXT_RELAYROOM_STATUS_FIELD=custom_relayroom_status
# ERPNEXT_RESERVE_METHOD=your_app.api.reserve_relayroom_stock
# ERPNEXT_COMMIT_RESERVATION_METHOD=your_app.api.commit_relayroom_reservation
# ERPNEXT_RELEASE_RESERVATION_METHOD=your_app.api.release_relayroom_reservation
# SHIPPO_API_TOKEN=shippo_test_your_token
# SHIPPO_FROM_NAME=Demo Warehouse
# SHIPPO_FROM_STREET1=215 Clayton St.
# SHIPPO_FROM_CITY=San Francisco
# SHIPPO_FROM_STATE=CA
# SHIPPO_FROM_ZIP=94117
# SHIPPO_TO_NAME=Demo Customer
# SHIPPO_TO_STREET1=731 Market St
# SHIPPO_TO_CITY=San Francisco
# SHIPPO_TO_STATE=CA
# SHIPPO_TO_ZIP=94103
# Internal addresses used by the approval service and commit dependency checks.
BUYER_API_URL=http://localhost:8784
SUPPLIER_API_URL=http://localhost:8785
CARRIER_API_URL=http://localhost:8786

# Optional live model planning. Provider order is OpenAI, Gemini, then the
# validated deterministic solver. Keep both API keys server-side only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Polar sandbox configuration.
POLAR_SERVER=sandbox
POLAR_ACCESS_TOKEN=
POLAR_PRODUCT_ID=
POLAR_CHECKOUT_URL=
POLAR_WEBHOOK_SECRET=
